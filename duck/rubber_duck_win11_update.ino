void duckyString(const uint8_t* keys, size_t len) {  
    for(size_t i=0; i<len; i+=2) {
        DigiKeyboard.sendKeyStroke(pgm_read_byte_near(keys + i+1), pgm_read_byte_near(keys + i));
    }
}

void setup() {
  //empty
}
void loop() {
  DigiKeyboard.delay(2000);
  DigiKeyboard.sendKeyStroke(0);
  //DigiKeyboard.sendKeyStroke(21, 8); // GUI R
  DigiKeyboard.sendKeyStroke(KEY_R, MOD_GUI_LEFT);
  DigiKeyboard.delay(3000);
  //DigiKeyboard.print("https://raw.githubusercontent.com/pedroaovieira/osint/refs/heads/main/duck/ransomware.jpg");
  duckyString(url_array, sizeof(url_array)); // STRING 
  //DigiKeyboard.sendKeyStroke(40, 0); // ENTER
  DigiKeyboard.sendKeyStroke(KEY_ENTER);
  DigiKeyboard.delay(2000);
  DigiKeyboard.sendKeyStroke(KEY_F11);
  for(;;){ /*empty*/ }
}

